# Auto-set by Vercel when you create the Neon database (Storage -> Create Database):
DATABASE_URL=

# Copy this file to ".env" and fill in your real keys.
# NEVER commit your real .env file (it is git-ignored on purpose).

# From https://api.congress.gov/sign-up/
CONGRESS_API_KEY=

# From https://console.anthropic.com/ (Settings -> API Keys)
ANTHROPIC_API_KEY=

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile)
TURNSTILE_SECRET_KEY=

# Optional: which Claude model writes the bill summaries (defaults to claude-sonnet-4-6)
SUMMARY_MODEL=

# From resend.com dashboard, API Keys
RESEND_API_KEY=

# Long random string, generate with openssl rand -hex 32
CRON_SECRET=

# From courtlistener.com profile, API page
COURTLISTENER_API_TOKEN=

# Comma-separated emails allowed to use the /admin/crosswalk review queue.
# Leave empty to disable admin review entirely (fail closed).
ADMIN_EMAILS=

# From https://api.census.gov/data/key_signup.html - used by the SNAP,
# Medicaid, and Money Map syncs (they fail without it)
CENSUS_API_KEY=

# From https://api.open.fec.gov/developers/ - campaign finance syncs
# (also set as a GitHub Actions secret for the monthly ETL workflow)
FEC_API_KEY=

# Public base URL of the site - used in magic-link emails, floor alerts,
# and checkout redirects (defaults to https://checkyourrepresentative.com)
SITE_URL=

# Optional: Google Maps geocoding fallback for address lookup
GOOGLE_MAPS_API_KEY=

# Optional: Stripe secret key for the merch checkout
STRIPE_SECRET_KEY=
